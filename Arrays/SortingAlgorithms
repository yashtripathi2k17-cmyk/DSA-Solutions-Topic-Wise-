#include <iostream>
#include <vector>
using namespace std;

int partition(vector<int>& arr, int st, int end) {

    int idx = st - 1;
    int pivot = arr[end];

    for (int j = st; j <= end - 1; j++) {

        if (arr[j] <= pivot) {
            idx++;
            swap(arr[j], arr[idx]);
        }
    }

    // Put pivot at its correct position
    idx++;
    swap(arr[end], arr[idx]);

    return idx;
}

void quickSort(vector<int>& arr, int st, int end) {

    if (st < end) {

        int pivIdx = partition(arr, st, end);

        // Sort left part
        quickSort(arr, st, pivIdx - 1);

        // Sort right part
        quickSort(arr, pivIdx + 1, end);
    }
}

int main() {

    vector<int> arr = {2, 1, 3, 4, 5, 6};

    quickSort(arr, 0, arr.size() - 1);

    for (int val : arr) {
        cout << val << " ";
    }

    return 0;
}

